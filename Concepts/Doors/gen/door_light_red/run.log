from pathlib import Path
import struct,zlib,collections
p=max((p for p in Path('/Users/manuel.diaz/.codex/generated_images').rglob('*.png') if p.is_file()),key=lambda p:p.stat().st_mtime_ns)
b=p.read_bytes(); w,h=struct.unpack('>II',b[16:24]); depth,ct=b[24:26]; channels={2:3,6:4}[ct]
assert depth==8 and (w,h)==(1024,1024)
pos=8; compressed=b''
while pos<len(b):
    n=struct.unpack('>I',b[pos:pos+4])[0]; typ=b[pos+4:pos+8]; data=b[pos+8:pos+8+n]; pos+=n+12
    if typ==b'IDAT': compressed+=data
raw=zlib.decompress(compressed); stride=w*channels; prior=bytearray(stride); rows=[]
def paeth(a,b,c):
    v=a+b-c; x=abs(v-a); y=abs(v-b); z=abs(v-c)
    return a if x<=y and x<=z else b if y<=z else c
for y in range(h):
    f=raw[y*(stride+1)]; row=bytearray(raw[y*(stride+1)+1:(y+1)*(stride+1)])
    for i in range(stride):
        a=row[i-channels] if i>=channels else 0; up=prior[i]; c=prior[i-channels] if i>=channels else 0
        extra=0 if f==0 else a if f==1 else up if f==2 else (a+up)//2 if f==3 else paeth(a,up,c)
        row[i]=(row[i]+extra)%256
    rows.append(row); prior=row
border=collections.Counter(tuple(rows[y][channels*x:channels*x+3]) for y in range(h) for x in range(w) if x<120 or x>=w-120 or y<120 or y>=h-120)
assert set(border)=={(255,255,255)}
if channels==4:
    assert all(row[i]==255 for row in rows for i in range(3,stride,4))
print('Newest final image:',p)
print('Dimensions:',(w,h))
print('Outer margin:',dict(border))
print('PNG is fully opaque')
