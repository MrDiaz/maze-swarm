@@ -0,0 +1,68 @@
+import AppKit
+import Foundation
+
+let sourceURL = URL(fileURLWithPath: CommandLine.arguments[1])
+let outputURL = URL(fileURLWithPath: CommandLine.arguments[2])
+let source = NSBitmapImageRep(data: try Data(contentsOf: sourceURL))!
+let sourceImage = source.cgImage!
+let width = sourceImage.width
+let height = sourceImage.height
+let colorSpace = CGColorSpaceCreateDeviceRGB()
+let bitmapInfo = CGImageAlphaInfo.premultipliedLast.rawValue
+var pixels = [UInt8](repeating: 255, count: width * height * 4)
+pixels.withUnsafeMutableBytes { memory in
+    let context = CGContext(data: memory.baseAddress, width: width, height: height,
+        bitsPerComponent: 8, bytesPerRow: width * 4, space: colorSpace,
+        bitmapInfo: bitmapInfo)!
+    context.draw(sourceImage, in: CGRect(x: 0, y: 0, width: width, height: height))
+}
+
+// Normalize only the near-white background connected to the canvas edge
+// or to the center of the empty opening. Preserve the generated prop.
+var visited = [Bool](repeating: false, count: width * height)
+var queue = [Int]()
+func enqueue(_ index: Int) {
+    if visited[index] { return }
+    visited[index] = true
+    let offset = index * 4
+    if pixels[offset] >= 240 && pixels[offset + 1] >= 240 && pixels[offset + 2] >= 240 {
+        queue.append(index)
+    }
+}
+for x in 0..<width {
+    enqueue(x)
+    enqueue((height - 1) * width + x)
+}
+for y in 0..<height {
+    enqueue(y * width)
+    enqueue(y * width + width - 1)
+}
+enqueue((height / 2) * width + width / 2)
+var cursor = 0
+while cursor < queue.count {
+    let index = queue[cursor]
+    cursor += 1
+    let offset = index * 4
+    for channel in 0..<4 { pixels[offset + channel] = 255 }
+    let x = index % width
+    let y = index / width
+    if x > 0 { enqueue(index - 1) }
+    if x + 1 < width { enqueue(index + 1) }
+    if y > 0 { enqueue(index - width) }
+    if y + 1 < height { enqueue(index + width) }
+}
+let provider = CGDataProvider(data: Data(pixels) as CFData)!
+let cleanedImage = CGImage(width: width, height: height, bitsPerComponent: 8,
+    bitsPerPixel: 32, bytesPerRow: width * 4, space: colorSpace,
+    bitmapInfo: CGBitmapInfo(rawValue: bitmapInfo), provider: provider,
+    decode: nil, shouldInterpolate: true, intent: .defaultIntent)!
+let outputContext = CGContext(data: nil, width: 1024, height: 1024,
+    bitsPerComponent: 8, bytesPerRow: 1024 * 4, space: colorSpace,
+    bitmapInfo: bitmapInfo)!
+outputContext.setFillColor(CGColor(red: 1, green: 1, blue: 1, alpha: 1))
+outputContext.fill(CGRect(x: 0, y: 0, width: 1024, height: 1024))
+outputContext.interpolationQuality = .high
+outputContext.draw(cleanedImage, in: CGRect(x: 92, y: 92, width: 840, height: 840))
+let output = NSBitmapImageRep(cgImage: outputContext.makeImage()!)
+try output.representation(using: .png, properties: [:])!.write(to: outputURL)
+print("Saved \(outputURL.path) — \(output.pixelsWide) × \(output.pixelsHigh) PNG")

