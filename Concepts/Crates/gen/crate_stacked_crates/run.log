@@ -0,0 +1,61 @@
+import AppKit
+import CoreGraphics
+
+let inputURL = URL(fileURLWithPath: CommandLine.arguments[1])
+let outputURL = URL(fileURLWithPath: CommandLine.arguments[2])
+guard let source = NSImage(contentsOf: inputURL),
+      let cgSource = source.cgImage(forProposedRect: nil, context: nil, hints: nil)
+else { fatalError("Cannot read generated PNG") }
+let size = 1024
+let stride = size * 4
+let pixelData = UnsafeMutablePointer<UInt8>.allocate(capacity: size * stride)
+defer { pixelData.deallocate() }
+guard let context = CGContext(
+    data: pixelData, width: size, height: size, bitsPerComponent: 8,
+    bytesPerRow: stride, space: CGColorSpace(name: CGColorSpace.sRGB)!,
+    bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
+) else { fatalError("Cannot create export canvas") }
+context.setFillColor(CGColor(red: 1, green: 1, blue: 1, alpha: 1))
+context.fill(CGRect(x: 0, y: 0, width: size, height: size))
+context.interpolationQuality = .high
+context.draw(cgSource, in: CGRect(x: 0, y: 0, width: size, height: size))
+
+// Normalize only the nearly-white background connected to the canvas edges.
+var visited = [Bool](repeating: false, count: size * size)
+var queue = [Int]()
+queue.reserveCapacity(size * size)
+func enqueue(_ index: Int) {
+    guard !visited[index] else { return }
+    visited[index] = true
+    let p = index * 4
+    let lo = min(pixelData[p], pixelData[p + 1], pixelData[p + 2])
+    let hi = max(pixelData[p], pixelData[p + 1], pixelData[p + 2])
+    guard lo >= 245, hi - lo <= 10 else { return }
+    pixelData[p] = 255
+    pixelData[p + 1] = 255
+    pixelData[p + 2] = 255
+    pixelData[p + 3] = 255
+    queue.append(index)
+}
+for n in 0..<size {
+    enqueue(n)
+    enqueue((size - 1) * size + n)
+    enqueue(n * size)
+    enqueue(n * size + size - 1)
+}
+var head = 0
+while head < queue.count {
+    let n = queue[head]
+    head += 1
+    let x = n % size
+    let y = n / size
+    if x > 0 { enqueue(n - 1) }
+    if x + 1 < size { enqueue(n + 1) }
+    if y > 0 { enqueue(n - size) }
+    if y + 1 < size { enqueue(n + size) }
+}
+guard let image = context.makeImage(),
+      let png = NSBitmapImageRep(cgImage: image).representation(using: .png, properties: [:])
+else { fatalError("Cannot encode PNG") }
+try png.write(to: outputURL)
+print("Exported \(size) x \(size) PNG; normalized \(queue.count) exterior background pixels to #FFFFFF")

